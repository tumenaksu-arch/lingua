{
  "expo": {
    "name": "Lingua",
    "slug": "lingotr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tumenaksu.lingua",
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#58CC02",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tumenaksu.lingua",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "tr",
      "themeColor": "#58CC02",
      "description": "Türkçe'den İngilizce, Almanca, İspanyolca ve Fransızca öğren: kısa dersler, aralıklı tekrar, günlük seri."
    },
    "scheme": "lingua",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lingua konuşma alıştırmaları için mikrofonu kullanır.",
          "speechRecognitionPermission": "Lingua telaffuzunuzu değerlendirmek için konuşma tanımayı kullanır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#58CC02"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#58CC02",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#131F24"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3e4b1660-a1ee-4248-be08-8b374107757a"
      }
    }
  }
}
