{
  "expo": {
    "name": "Lingua",
    "slug": "lingua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tumenaksu.lingua"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tumenaksu.lingua"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lingua",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lingua konu\u015fma al\u0131\u015ft\u0131rmalar\u0131 i\u00e7in mikrofonu kullan\u0131r.",
          "speechRecognitionPermission": "Lingua telaffuzunuzu de\u011ferlendirmek i\u00e7in konu\u015fma tan\u0131may\u0131 kullan\u0131r."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
